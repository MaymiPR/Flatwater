# Text files are stored and checked out with LF line endings on every
# platform; the Windows installer script and the PowerShell scripts keep CRLF.
* text=auto eol=lf
*.iss text eol=crlf
*.ps1 text eol=crlf

# Binary data
*.wav binary
*.f32 binary
*.npy binary
*.npz binary
*.png binary
*.flp binary
*.fst binary
*.pkl binary
*.bin binary
*.ttf binary

# Generated headers (nets, measured tables, image data, presets: each says which tool writes it). A regeneration
# rewrites them wholesale, so GitHub collapses their diffs and no formatter or whitespace check touches them.
plugins/FwBassLift/Source/dsp/GainNet.h linguist-generated=true
plugins/FwBassLift/Source/Presets.h linguist-generated=true
plugins/FwBassLeveler/Source/Presets.h linguist-generated=true
