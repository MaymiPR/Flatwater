# Build output (CMake, Visual Studio, Xcode, Ninja) and the installers
build/
build-*/
out/
_deps/
dist/
site/
.vs/
.vscode/
.idea/
.cache/
*.user
CMakeUserPresets.json
compile_commands.json

# Python
__pycache__/
*.pyc
.venv/

# OS files
.DS_Store
Thumbs.db

# Kept out of the repository: anything taken from the original plug-ins (screenshots, extracted resources), every
# reference render and every result file. measurements/ is published for this suite (CONTRIBUTING.md, Deviations
# from the standard); its raw numpy arrays are large and regenerable.
reference/
measurements/**/*.npz
measurements/**/*.npy
**/nulltest/renders/
**/nulltest/reference_renders/
**/nulltest/results*.json
**/__pycache__/

# Compiled helpers of the null tests (built locally by their .bat files)
**/nulltest/*.exe
**/nulltest/*.obj
**/nulltest/*.exp
**/nulltest/*.lib
**/nulltest/*.dll

# Signing material never enters the repository (it lives in GitHub's Actions secrets)
*.p12
*.pfx
*.p8
*.cer
*.mobileprovision

# generated by packaging/make_iss_include.ps1 (local paths)
packaging/plugins.iss.inc

# Machine paths (the reference's VST3, the interpreters, the tool folders): local.example.yaml lists the keys
local.yaml

# The local check's build log
build.log
