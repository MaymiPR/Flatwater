# Provenance: what this repository may hold and ship. The release check reads this file: a release fails on a file
# the gate stops unless an allow: line keeps it, with the reason and the approval recorded with its date.
#
# vendor: words that never appear in a control label, a preset name, a file name or a plug-in name
vendor: Waves, Renaissance, MaxxBass, H-Comp, H-Delay, Bass Rider, Vocal Rider, CLA, Vocal Bender
#
# allow: <path glob>  <reason, with the approval recorded and its date>
allow: plugins/FwVocalChain/resources/ir/*.bin  measured reverb responses, after the model-first attempt (approval recorded, 2026-10-28)
allow: plugins/*/tests/data/state-*.bin  the host test's saved-state fixtures, written by our own build of each release (the suite standard's fixtures, approved 2026-11-09)
